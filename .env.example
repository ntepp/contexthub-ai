# ContextHub — DEVELOPMENT configuration (copy to .env).
# Production: start from .env.production.example instead.

ENVIRONMENT=development
LOG_LEVEL=INFO
PUBLIC_URL=http://localhost:5173

# Bootstrap administrator, created at API start-up if no admin exists.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Change-Me-Dev-2026!

# Sessions are signed with this key (any long random string).
SECRET_KEY=dev-only-change-me-0123456789abcdef0123456789

# ------------------------------------------------------------------ LLM
# Allow-list shown in the UI, "provider:model", first = default.
# Providers: ollama | anthropic | openai | openai_compatible
LLM_MODELS=ollama:llama3.1:8b
# LLM_MODELS=ollama:llama3.1:8b,anthropic:claude-sonnet-5-5,openai:gpt-4o
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_REASONING=false
OLLAMA_NUM_CTX=8192
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OpenAI-compatible endpoint (Mistral La Plateforme, vLLM, LM Studio…)
# OPENAI_COMPATIBLE_BASE_URL=https://api.mistral.ai/v1
# OPENAI_COMPATIBLE_API_KEY=
# OPENAI_COMPATIBLE_LABEL=Mistral
# OPENAI_COMPATIBLE_IS_LOCAL=false

# ------------------------------------------------------------------ Embeddings
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024

# ------------------------------------------------------------------ Retrieval
# Max cosine DISTANCE for a chunk to be kept (0.0 = identical, higher = less relevant).
RETRIEVAL_MAX_DISTANCE=0.75
# Chunks given to the LLM after filtering, and candidates fetched per search arm.
RETRIEVAL_TOP_K=8
RETRIEVAL_CANDIDATES=40
RETRIEVAL_HYBRID=true
FTS_LANGUAGE=fr_unaccent
# Sentence emitted verbatim when the corpus does not support an answer. Must be in the
# language of the corpus.
NO_ANSWER_TEXT=L'information n'est pas disponible dans la base de connaissances actuelle.

# ------------------------------------------------------------------ Ingestion
UPLOAD_DIR=./uploads
UPLOAD_MAX_MB=50
OCR_ENABLED=true
ALLOW_URL_INGESTION=false

# ------------------------------------------------------------------ Infrastructure (docker-compose.dev.yaml)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=contexthub
REDIS_HOST=localhost
REDIS_PORT=6379

# ------------------------------------------------------------------ Observability
# LangSmith sends prompts — i.e. document excerpts — to a third-party SaaS. Off by default.
LANGCHAIN_TRACING_V2=false
# LANGSMITH_API_KEY=
