# ContextHub — DEVELOPMENT configuration (copy to .env).
# Production: start from .env.production.example instead.

ENVIRONMENT=development
LOG_LEVEL=INFO
PUBLIC_URL=http://localhost:5173

# Bootstrap administrator, created at API start-up if no admin exists.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Change-Me-Dev-2026!

# Sessions are signed with this key (any long random string).
SECRET_KEY=dev-only-change-me-0123456789abcdef0123456789

# ------------------------------------------------------------------ SSO (optional)
# Local Keycloak with demo accounts (deploy/keycloak/README.md):
#   docker compose -f docker-compose.dev.yaml --profile sso up -d
# OIDC_ISSUER=http://127.0.0.1:8081/realms/contexthub
# OIDC_CLIENT_ID=contexthub
# OIDC_CLIENT_SECRET=contexthub-dev-secret
# OIDC_LABEL=Keycloak
# Members of these groups become administrators; other groups can be granted collections
# in Administration > Accès.
# OIDC_ADMIN_GROUPS=contexthub-admins

# ------------------------------------------------------------------ LLM
# Allow-list shown in the UI, "provider:model", first = default.
# Providers: ollama | anthropic | openai | openai_compatible
LLM_MODELS=ollama:llama3.1:8b
# LLM_MODELS=ollama:llama3.1:8b,anthropic:claude-sonnet-5-5,openai:gpt-4o
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_REASONING=false
OLLAMA_NUM_CTX=8192
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OpenAI-compatible endpoint (Mistral La Plateforme, vLLM, LM Studio…)
# OPENAI_COMPATIBLE_BASE_URL=https://api.mistral.ai/v1
# OPENAI_COMPATIBLE_API_KEY=
# OPENAI_COMPATIBLE_LABEL=Mistral
# OPENAI_COMPATIBLE_IS_LOCAL=false

# ------------------------------------------------------------------ LLM gateway (optional, ADR-001)
# When LLM_GATEWAY_URL is set, every chat call goes through this OpenAI-compatible gateway
# (reference: LiteLLM), which owns costs, budgets and rate limits; ContextHub stores none and
# shows the consumption it reads there. Models become "gateway:<name>"; provider keys above
# are then not used. Local LiteLLM with dev keys: deploy/litellm/README.md
#   docker compose -f docker-compose.dev.yaml --profile gateway up -d
# LLM_GATEWAY_URL=http://127.0.0.1:4000
# LLM_GATEWAY_KIND=litellm
# Application key: chat calls and model list (create it with /key/generate).
# LLM_GATEWAY_API_KEY=
# Gateway administrator key, used only to read consumption and to manage per-user budgets
# (LiteLLM reserves both to admin keys). No fallback on LLM_GATEWAY_API_KEY: without it, chat
# works and the consumption and budget pages say they are not configured.
# LLM_GATEWAY_ADMIN_KEY=sk-contexthub-dev-only-master-key
# LLM_GATEWAY_LABEL=Passerelle LLM
# true only if every model the gateway serves runs inside your network (no "cloud" banner).
# LLM_GATEWAY_IS_LOCAL=false
# LLM_GATEWAY_TIMEOUT_SECONDS=10
# LLM_GATEWAY_MODELS_TTL_SECONDS=60
# Gateway console as the administrators' browser reaches it (link in Administration › Modèles).
# Empty: <LLM_GATEWAY_URL>/ui for LiteLLM, unless the host is a bare service name (e.g. "litellm").
# LLM_GATEWAY_CONSOLE_URL=

# ------------------------------------------------------------------ Embeddings
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024

# ------------------------------------------------------------------ Retrieval
# Max cosine DISTANCE for a chunk to be kept (0.0 = identical, higher = less relevant).
RETRIEVAL_MAX_DISTANCE=0.75
# Chunks given to the LLM after filtering, and candidates fetched per search arm.
RETRIEVAL_TOP_K=8
RETRIEVAL_CANDIDATES=40
RETRIEVAL_HYBRID=true
FTS_LANGUAGE=fr_unaccent
# A question citing a product reference (US30010CNG…) also searches the documents that carry it;
# their passages get this on the fused (RRF) score, passages about other products are left out.
RETRIEVAL_REFERENCE_BOOST=0.02
# Adjacent passages (same document and section, next pages) joined around each kept passage, on
# each side (0 = none), within a budget for the whole context sent to the LLM, in characters.
RETRIEVAL_NEIGHBOURS=1
RETRIEVAL_CONTEXT_CHARS=12000
# Optional local re-ranking of the candidates with a cross-encoder (pip install -r requirements-rerank.txt,
# PyTorch ~2 GB; the model, ~2.3 GB, is downloaded once into the HuggingFace cache). Best on a GPU: on a CPU it adds
# seconds per question.
RERANKER=none
# RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# Only the N best candidates after fusion are re-ranked; the others keep their order behind them.
RERANK_CANDIDATES=30
# Pairs (query, passage) scored for one answer, question and planner sub-queries together: the question takes
# up to RERANK_CANDIDATES, the sub-queries share the rest equally (below 2 each, they are not re-ranked).
RERANK_MAX_PAIRS=60
# auto = CUDA when PyTorch sees a GPU, else CPU; or a PyTorch device (cpu, cuda, cuda:1).
RERANKER_DEVICE=auto
# CPU threads (0 = PyTorch's default, one per physical core). Batch size, tokens read per pair.
RERANKER_THREADS=0
RERANKER_BATCH_SIZE=16
RERANKER_MAX_LENGTH=512
# Read local models from the HuggingFace cache only, with no call to the Hub (not even an update check).
# Download the model once with HF_HUB_OFFLINE=false, then set it to true.
HF_HUB_OFFLINE=false
# Agentic retrieval: the LLM splits multi-part questions into up to N sub-queries, searched on top of the question.
# Costs one extra LLM call per answered question; refusals stay LLM-free.
AGENTIC_RETRIEVAL=true
AGENTIC_MAX_QUERIES=3
# Sentence emitted verbatim when the corpus does not support an answer. Must be in the
# language of the corpus.
NO_ANSWER_TEXT=L'information n'est pas disponible dans la base de connaissances actuelle.
# Follows NO_ANSWER_TEXT when every source found is about another product than the one the
# question cites: {found} = their references, {asked} = the question's.
PRODUCT_MISMATCH_TEXT=Les sources trouvées concernent {found}, pas {asked}.
# Contexte métier ajouté au prompt (optionnel), ex. « Tu assistes le support informatique d'ACME. »
ASSISTANT_CONTEXT=

# ------------------------------------------------------------------ Ingestion
UPLOAD_DIR=./uploads
UPLOAD_MAX_MB=50
OCR_ENABLED=true
# Scanned documents (images, PDF pages without a usable text layer) are read by Tesseract on
# the "ocr" queue, served by its own worker: python -m src.workers.ocr_worker (start.sh does it).
OCR_LANGUAGES=fra+eng
# A PDF page with fewer letters and digits than this is read by OCR.
OCR_MIN_PAGE_CHARS=50
# A PDF page whose extracted text is mostly unreadable (share of letters forming plausible words
# below this, 0-1: fonts without a Unicode table, labels of a drawing whose text is an image) is
# read by OCR whatever its length.
OCR_MIN_TEXT_QUALITY=0.5
# Pages read with a lower mean confidence (0-100) are reported as "lecture partielle".
OCR_MIN_CONFIDENCE=60
OCR_DPI=300
OCR_PAGE_TIMEOUT_SECONDS=120
OCR_WORKER_CONCURRENCY=1
ALLOW_URL_INGESTION=false
# One chunk per definition in definitions articles and glossaries (reindex existing documents).
CHUNK_DEFINITIONS=true
# Technical documents (numbered sections such as "3.2.2 Title", tables: manuals, procedures) are
# cut into passages of this size at paragraph breaks; 0 = cut them like any other text (reindex).
CHUNK_SIZE_TECHNICAL=800

# ------------------------------------------------------------------ Connectors (Confluence, Notion)
# Users attach chosen pages to a conversation; nothing is synchronised in bulk.
# Connections are created in Administration > Connecteurs (token encrypted with SECRET_KEY).
# Demo without a real Confluence: python -m tests.e2e.mock_confluence
CONNECTORS_ENABLED=true
# CONNECTOR_MAX_PAGES_PER_CONVERSATION=20
# CONNECTOR_MAX_PAGE_MB=5

# ------------------------------------------------------------------ Infrastructure (docker-compose.dev.yaml)
# 127.0.0.1 rather than localhost: on Windows, localhost may resolve to ::1 first and stall for a minute.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=contexthub
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ------------------------------------------------------------------ Observability
# LangSmith sends prompts — i.e. document excerpts — to a third-party SaaS. Off by default.
LANGCHAIN_TRACING_V2=false
# LANGSMITH_API_KEY=
