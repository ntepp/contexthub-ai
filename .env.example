# LLM Provider — "ollama" or "openai"
LLM_PROVIDER=ollama
LLM_MODEL_NAME=llama3.1:8b

# Required only when LLM_PROVIDER=openai
OPENAI_API_KEY=sk-...

# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434

# HTTP client identification
USER_AGENT=contexthub-ai/1.0

# Retrieval — max cosine DISTANCE for a chunk to be kept (0.0 = identical match,
# higher = less relevant). Lower this value to be stricter, raise it to be laxer.
RETRIEVAL_MAX_DISTANCE=0.75

# Number of candidate chunks pulled from pgvector BEFORE the distance filter.
# This is the hard ceiling on retrieval: the threshold can only ever discard
# from these k candidates, never reach past them.
RETRIEVAL_TOP_K=4

# Sentence emitted verbatim when the corpus does not support an answer — both by
# the retriever (nothing under the distance threshold) and by the LLM. Must be
# written in the language of the indexed corpus.
NO_ANSWER_TEXT=L'information n'est pas disponible dans la base de connaissances actuelle.

# Backend log verbosity — DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# PostgreSQL + pgvector (started via docker-compose)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=contexthub

# Redis (started via docker-compose)
REDIS_HOST=localhost
REDIS_PORT=6379

# LangSmith — observability & tracing (https://smith.langchain.com)
LANGSMITH_API_KEY=lsv2_...
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=contexthub-ai
