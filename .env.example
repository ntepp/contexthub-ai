# LLM Provider — "ollama" or "openai"
LLM_PROVIDER=ollama
LLM_MODEL_NAME=llama3.1:8b

# Required only when LLM_PROVIDER=openai
OPENAI_API_KEY=sk-...

# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434

# HTTP client identification
USER_AGENT=contexthub-ai/1.0

# Retrieval — max cosine DISTANCE for a chunk to be kept (0.0 = identical match,
# higher = less relevant). Lower this value to be stricter, raise it to be laxer.
RETRIEVAL_MAX_DISTANCE=0.75

# Backend log verbosity — DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# PostgreSQL + pgvector (started via docker-compose)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=contexthub

# Redis (started via docker-compose)
REDIS_HOST=localhost
REDIS_PORT=6379

# LangSmith — observability & tracing (https://smith.langchain.com)
LANGSMITH_API_KEY=lsv2_...
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=contexthub-ai
