# ContextHub — PRODUCTION configuration for docker-compose.yaml.
#   cp .env.production.example .env && chmod 600 .env
# Every "change-me" must be replaced; the API refuses to start with insecure defaults.
# Generate secrets with:  openssl rand -base64 48

CONTEXTHUB_VERSION=1.0.0
PUBLIC_URL=https://contexthub.example.fr
LOG_LEVEL=INFO
LOG_FORMAT=json

# Web entry point. NGINX_CONF=http behind your own TLS reverse proxy, or tls to let the
# bundled nginx terminate TLS (put fullchain.pem + privkey.pem in TLS_CERT_DIR).
NGINX_CONF=http
HTTP_PORT=8080
HTTPS_PORT=8443
TLS_CERT_DIR=./docker/nginx/certs
# Only for a trial without any TLS in front: cookies would otherwise never be sent.
# COOKIE_SECURE=false

SECRET_KEY=change-me
POSTGRES_USER=contexthub
POSTGRES_PASSWORD=change-me
POSTGRES_DB=contexthub
REDIS_PASSWORD=change-me

# First administrator (created once, then remove ADMIN_PASSWORD from this file).
ADMIN_EMAIL=admin@client.fr
ADMIN_PASSWORD=change-me

SESSION_TTL_MINUTES=480

# ------------------------------------------------------------------ SSO (OpenID Connect)
# Redirect URI to register at the IdP: ${PUBLIC_URL}/api/auth/oidc/callback
# OIDC_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_LABEL=Microsoft Entra ID
# OIDC_ALLOWED_DOMAINS=client.fr
# OIDC_ADMIN_GROUPS=<group-object-id>
# LOCAL_LOGIN_ENABLED=true

# ------------------------------------------------------------------ LLM
# 100 % local (no data leaves the network):
LLM_MODELS=ollama:llama3.1:8b
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_REASONING=false
OLLAMA_NUM_CTX=8192
# Cloud providers are opt-in: each one listed here becomes selectable in the UI, which
# flags it as "cloud". Excerpts of the documents are then sent to that provider.
# LLM_MODELS=ollama:llama3.1:8b,anthropic:claude-sonnet-5-5,openai_compatible:mistral-large-latest
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENAI_COMPATIBLE_BASE_URL=https://api.mistral.ai/v1
# OPENAI_COMPATIBLE_API_KEY=
# OPENAI_COMPATIBLE_LABEL=Mistral
# OPENAI_COMPATIBLE_IS_LOCAL=false

# ------------------------------------------------------------------ LLM gateway (optional, ADR-001)
# Your OpenAI-compatible gateway (reference: LiteLLM). When set, every chat call goes through
# it, tagged with the user's ContextHub UUID only; costs, budgets and rate limits are managed
# there and shown read-only in ContextHub (no cost data stored). Models become "gateway:<name>".
# See docs/deployment.md, "Passerelle LLM".
# LLM_GATEWAY_URL=http://litellm.internal:4000
# LLM_GATEWAY_KIND=litellm
# Required with LLM_GATEWAY_URL: application key (chat calls, model list), server side only.
# LLM_GATEWAY_API_KEY=change-me
# Optional: gateway administrator key, used only to read consumption and to manage per-user
# budgets (LiteLLM: full proxy_admin key). No fallback on LLM_GATEWAY_API_KEY (least
# privilege): without it, chat works and the consumption and budget pages say they are not configured.
# LLM_GATEWAY_ADMIN_KEY=change-me
# LLM_GATEWAY_LABEL=Passerelle LLM
# true only if every model the gateway serves runs inside your network.
# LLM_GATEWAY_IS_LOCAL=false
# LLM_GATEWAY_TIMEOUT_SECONDS=10
# LLM_GATEWAY_MODELS_TTL_SECONDS=60
# Gateway console as the administrators' browser reaches it (link in Administration › Modèles).
# Empty: <LLM_GATEWAY_URL>/ui for LiteLLM, unless the host is a bare service name (e.g. "litellm").
# LLM_GATEWAY_CONSOLE_URL=

EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024

# ------------------------------------------------------------------ Retrieval
RETRIEVAL_MAX_DISTANCE=0.75
RETRIEVAL_TOP_K=8
RETRIEVAL_CANDIDATES=40
RETRIEVAL_HYBRID=true
FTS_LANGUAGE=fr_unaccent
AGENTIC_RETRIEVAL=true
AGENTIC_MAX_QUERIES=3
NO_ANSWER_TEXT=L'information n'est pas disponible dans la base de connaissances actuelle.
# Contexte métier ajouté au prompt (optionnel), ex. « Tu assistes le support informatique d'ACME. »
ASSISTANT_CONTEXT=

# ------------------------------------------------------------------ Ingestion
UPLOAD_MAX_MB=50
OCR_ENABLED=true
# Scanned documents (images, PDF pages without a usable text layer) are read by Tesseract on
# the "ocr" queue, served by its own worker: python -m src.workers.ocr_worker (service worker-ocr).
OCR_LANGUAGES=fra+eng
# A PDF page with fewer letters and digits than this is read by OCR.
OCR_MIN_PAGE_CHARS=50
# A PDF page whose extracted text is mostly unreadable (share of letters forming plausible words
# below this, 0-1: fonts without a Unicode table, labels of a drawing whose text is an image) is
# read by OCR whatever its length.
OCR_MIN_TEXT_QUALITY=0.5
# Pages read with a lower mean confidence (0-100) are reported as "lecture partielle".
OCR_MIN_CONFIDENCE=60
OCR_DPI=300
OCR_PAGE_TIMEOUT_SECONDS=120
OCR_WORKER_CONCURRENCY=1
ALLOW_URL_INGESTION=false
# Confluence / Notion connectors: users attach chosen pages to a conversation (no bulk sync).
# Connections are created in Administration > Connecteurs.
CONNECTORS_ENABLED=true
WORKER_CONCURRENCY=2

# ------------------------------------------------------------------ Retention (days, 0 = keep)
# Set to your own record-keeping obligations (e.g. 5 years for French investment firms).
AUDIT_RETENTION_DAYS=1825
CONVERSATION_RETENTION_DAYS=365

LANGCHAIN_TRACING_V2=false
