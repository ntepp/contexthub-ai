# ContextHub — PRODUCTION configuration for docker-compose.yaml.
#   cp .env.production.example .env && chmod 600 .env
# Every "change-me" must be replaced; the API refuses to start with insecure defaults.
# Generate secrets with:  openssl rand -base64 48

CONTEXTHUB_VERSION=1.0.0
PUBLIC_URL=https://contexthub.example.fr
LOG_LEVEL=INFO
LOG_FORMAT=json

# Web entry point. NGINX_CONF=http behind your own TLS reverse proxy, or tls to let the
# bundled nginx terminate TLS (put fullchain.pem + privkey.pem in TLS_CERT_DIR).
NGINX_CONF=http
HTTP_PORT=8080
HTTPS_PORT=8443
TLS_CERT_DIR=./docker/nginx/certs
# Only for a trial without any TLS in front: cookies would otherwise never be sent.
# COOKIE_SECURE=false

SECRET_KEY=change-me
POSTGRES_USER=contexthub
POSTGRES_PASSWORD=change-me
POSTGRES_DB=contexthub
REDIS_PASSWORD=change-me

# First administrator (created once, then remove ADMIN_PASSWORD from this file).
ADMIN_EMAIL=admin@client.fr
ADMIN_PASSWORD=change-me

SESSION_TTL_MINUTES=480

# ------------------------------------------------------------------ SSO (OpenID Connect)
# Redirect URI to register at the IdP: ${PUBLIC_URL}/api/auth/oidc/callback
# OIDC_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_LABEL=Microsoft Entra ID
# OIDC_ALLOWED_DOMAINS=client.fr
# OIDC_ADMIN_GROUPS=<group-object-id>
# LOCAL_LOGIN_ENABLED=true

# ------------------------------------------------------------------ LLM
# 100 % local (no data leaves the network):
LLM_MODELS=ollama:llama3.1:8b
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_REASONING=false
OLLAMA_NUM_CTX=8192
# Cloud providers are opt-in: each one listed here becomes selectable in the UI, which
# flags it as "cloud". Excerpts of the documents are then sent to that provider.
# LLM_MODELS=ollama:llama3.1:8b,anthropic:claude-sonnet-5-5,openai_compatible:mistral-large-latest
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENAI_COMPATIBLE_BASE_URL=https://api.mistral.ai/v1
# OPENAI_COMPATIBLE_API_KEY=
# OPENAI_COMPATIBLE_LABEL=Mistral
# OPENAI_COMPATIBLE_IS_LOCAL=false

EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024

# ------------------------------------------------------------------ Retrieval
RETRIEVAL_MAX_DISTANCE=0.75
RETRIEVAL_TOP_K=8
RETRIEVAL_CANDIDATES=40
RETRIEVAL_HYBRID=true
FTS_LANGUAGE=fr_unaccent
NO_ANSWER_TEXT=L'information n'est pas disponible dans la base de connaissances actuelle.
# Contexte métier ajouté au prompt (optionnel), ex. « Tu assistes le support informatique d'ACME. »
ASSISTANT_CONTEXT=

# ------------------------------------------------------------------ Ingestion
UPLOAD_MAX_MB=50
OCR_ENABLED=true
OCR_LANGUAGES=fra+eng
ALLOW_URL_INGESTION=false
WORKER_CONCURRENCY=2

# ------------------------------------------------------------------ Retention (days, 0 = keep)
# Set to your own record-keeping obligations (e.g. 5 years for French investment firms).
AUDIT_RETENTION_DAYS=1825
CONVERSATION_RETENTION_DAYS=365

LANGCHAIN_TRACING_V2=false
